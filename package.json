{
  "name": "n8n-nodes-shvl",
  "version": "0.1.1",
  "description": "Read SHVL credit-control briefs and receivables health in n8n.",
  "license": "MIT",
  "homepage": "https://shvl.app/cli",
  "keywords": [
    "n8n-community-node-package"
  ],
  "author": {
    "name": "Studea Limited",
    "email": "hello@studea.co.uk"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jlucwright/n8n-nodes-shvl.git"
  },
  "scripts": {
    "build": "n8n-node build",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "test": "node --test tests/*.test.cjs"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "examples"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/ShvlOAuth2Api.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Shvl/Shvl.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "0.54.3",
    "typescript": "5.9.2",
    "n8n-workflow": "2.45.1"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "engines": {
    "node": ">=22.22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
